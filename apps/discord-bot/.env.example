# Discord Developer Portal
DISCORD_TOKEN=
CLIENT_ID=
# Serveur de développement/production où les commandes sont enregistrées immédiatement.
GUILD_ID=

# GitHub fine-grained token limité au dépôt ciblé : Issues en lecture/écriture, et Contents en
# lecture/écriture pour archiver les captures jointes aux retours (branche ci-dessous).
GITHUB_TOKEN=
GITHUB_OWNER=NathanChevrollier
GITHUB_REPO=Zenytt
# Roadmap depuis le GitHub Project v2 : jeton « classic » avec la seule permission read:project
# (un jeton fine-grained ne peut pas lire le projet d'un compte personnel). Le projet dont le titre
# contient le nom du dépôt est trouvé seul ; GITHUB_PROJECT_NUMBER le force si besoin.
GITHUB_PROJECT_TOKEN=
GITHUB_PROJECT_NUMBER=

# IDs des salons où /setup-feedback publie les panneaux.
# Active le mode développeur Discord, clic droit sur chaque salon, puis « Copier l'identifiant ».
SUGGESTION_CHANNEL_ID=
BUG_CHANNEL_ID=

# Salon du panneau roadmap. Laisser vide pour désactiver la synchronisation automatique.
ROADMAP_CHANNEL_ID=
# Facultatif: ID du message roadmap déjà créé. Sinon le bot le retrouve dans les 50 derniers messages.
ROADMAP_MESSAGE_ID=
ROADMAP_SYNC_INTERVAL_MINUTES=15

# Branche du dépôt où archiver les captures d'écran des retours (créée au premier envoi, sans lien
# avec le code). Laisser vide pour retirer le champ « captures » du formulaire.
GITHUB_ATTACHMENTS_BRANCH=feedback-attachments
# Dépôt SÉPARÉ (même propriétaire) et jeton fine-grained dédié (Contents: Read and write sur ce seul
# dépôt) pour les captures : GITHUB_TOKEN reste limité aux issues du dépôt Zenytt.
GITHUB_ATTACHMENTS_REPO=
GITHUB_ATTACHMENTS_TOKEN=

# Labels GitHub utilisés pour les issues créées par le bot.
GITHUB_BUG_LABEL=bug
GITHUB_SUGGESTION_LABEL=enhancement
GITHUB_BRAINSTORMING_LABEL=brainstorming
GITHUB_IN_PROGRESS_LABEL=in-progress
GITHUB_TEST_LABEL=test
GITHUB_DONE_LABEL=done
NODE_ENV=production
