{
  "name": "zenytt-discord-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Bot Discord autonome pour collecter les retours Zenytt et créer des issues GitHub.",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@octokit/rest": "^21.1.1",
    "discord.js": "^14.22.1",
    "dotenv": "^17.2.2",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "tsx": "^4.20.5",
    "typescript": "~5.9.2",
    "vitest": "^4.1.11"
  }
}
