# Bloc nginx du sous-domaine de synchronisation et de partage (à adapter : domaine, port).
#
# La carte ci-dessous est nécessaire aux WebSockets des terminaux partagés. Si elle existe déjà
# ailleurs dans ta configuration nginx, ne la déclare pas deux fois.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ""      close;
}

# Limites par IP (anti-abus) : à déclarer dans le bloc http (conf.d/*.conf convient).
limit_req_zone $binary_remote_addr zone=zenytt_sync_req:10m rate=10r/s;
limit_conn_zone $binary_remote_addr zone=zenytt_sync_conn:10m;

# Certificat : sudo certbot certonly --nginx -d sync.exemple.fr
# (ou « Sites » → nouveau site dans Zenytt, qui s'occupe du vhost et du certificat).
server {
    listen 80;
    listen [::]:80;
    server_name sync.exemple.fr;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name sync.exemple.fr;

    ssl_certificate /etc/letsencrypt/live/sync.exemple.fr/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/sync.exemple.fr/privkey.pem;

    client_max_body_size 1m;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    limit_req zone=zenytt_sync_req burst=20 nodelay;
    limit_conn zenytt_sync_conn 20;

    location / {
        proxy_pass http://127.0.0.1:8091;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Terminaux partagés : connexions WebSocket, longues et bidirectionnelles.
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
        proxy_buffering off;
    }
}
